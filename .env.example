DEBUG=False
HOST_PORT=18743
JWT_SECRET=change_me_to_real_secret
SERVICE_API_KEY=change_me_service_api_key
DATABASE_URL=postgresql://whiteboard:whiteboard_pass@db:5432/whiteboard
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
CORS_ORIGINS=https://main-service.example.com
RATE_LIMIT_HTTP_PER_USER_PER_MINUTE=600
# Abuse backstop per source IP; keep high - universities NAT ~100 users behind one IP
RATE_LIMIT_HTTP_PER_IP_PER_MINUTE=5000
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_UPLOAD_POLL_PER_MINUTE=240
RATE_LIMIT_MIRO_IMPORT_PER_MINUTE=5
RATE_LIMIT_WS_TOKEN_PER_MINUTE=60
RATE_LIMIT_SOCKET_PER_10S=60
CELERY_WORKER_CONCURRENCY=2

# --- Media storage (Yandex Object Storage / любой S3) ---
# Пустой MEDIA_S3_BUCKET = хранить загрузки на локальном диске (dev-режим).
# Bucket держите приватным: файлы раздаются через приложение по /uploads/...
MEDIA_S3_BUCKET=
MEDIA_S3_LOCATION=media
MEDIA_S3_ENDPOINT_URL=https://storage.yandexcloud.net
MEDIA_S3_REGION_NAME=ru-central1
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# --- PostgreSQL backups (deploy/backup_db.sh, host cron + awscli) ---
# Ключи можно те же, что для медиа (или отдельный сервисный аккаунт с доступом
# только к этому бакету). Ротация в S3 - lifecycle-правилом в консоли Yandex
# или флагом --prune-s3 N.
PG_BACKUP_S3_PREFIX=s3://whiteboard-postgres/postgres/production
AWS_ENDPOINT=https://storage.yandexcloud.net
AWS_REGION=ru-central1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_KEEP_LOCAL=7
# Авто-удаление S3-дампов старше N дней при каждом бэкапе (0 = выключено)
BACKUP_S3_RETENTION_DAYS=30

# --- Очистка неактивных досок (scripts/cleanup_stale_boards.py, weekly cron) ---
# Критерий: boards.updated_at (последнее ИЗМЕНЕНИЕ) старше N дней.
# Удаляются строки досок (+ops/members каскадом), их медиа в S3/локально и кэш.
STALE_BOARD_DAYS=90
# Seconds to wait after the last write before compacting a board that crossed
# the op-count/size thresholds. Lower = boards stay compacted sooner (faster
# connect/replay), higher = fewer compaction runs under rapid edit bursts.
COMPACTION_DEBOUNCE_SECONDS=1.5
UVICORN_WORKERS=1
